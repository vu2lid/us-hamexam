{
  "name": "us-hamexam",
  "version": "0.3.0-beta.1",
  "description": "Offline FCC Technician Class ham radio study app (2026–2030).",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "npm run build && npm run test:unit && npm run test:standalone && npm run test:pwa",
    "test:unit": "node --test tests/unit/exam-engine.test.js",
    "test:smoke": "npm run build && playwright test --grep @smoke --project=chromium-desktop",
    "test:compat": "npm run build && playwright test --grep @compat --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop --project=webkit-mobile",
    "test:responsive": "npm run build && playwright test --grep @responsive --project=chromium-mobile --project=chromium-tablet --project=webkit-mobile --project=webkit-tablet",
    "test:full": "npm test",
    "test:standalone": "playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.js"
  },
  "keywords": [
    "ham-radio",
    "fcc",
    "technician",
    "amateur-radio",
    "study",
    "offline"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
